{
  "theme_color": "#fff",
  "background_color": "#000",
  "display": "standalone",
  "scope": "/",
  "start_url": "/start",
  "name": "SatsRoute",
  "description": "Bitcoin, Lightning e stablecoins (USDt, DePix) numa carteira simples",
  "short_name": "SatsRoute",
  "icons": [
    {
      "src": "/icon-512x512.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "maskable"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+bitcoin",
      "url": "/send/%s"
    },
    {
      "protocol": "bitcoin",
      "url": "/send/%s"
    }
  ]
}
